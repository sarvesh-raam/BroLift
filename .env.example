# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here
# Restrict this key to your domain (HTTP referrer) in Google Cloud Console.
# Needs: Maps JavaScript API, Places API, Directions API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Leave unset locally to use SQLite. On Render this is your PostgreSQL "Internal Database URL".
DATABASE_URL=sqlite:///brolift.db
